<odoo>
    <!-- 20.0: the cards of /my are portal.entry records, no longer a template -->
    <record id="portal_entry_bookings" model="portal.entry">
        <field name="name">Bookings</field>
        <field name="description">Schedule and follow your bookings</field>
        <field name="url">/my/bookings</field>
        <field
            name="image"
            type="bytes"
            file="resource_booking/static/src/img/portal_icon.svg"
        />
        <field name="placeholder_count">booking_count</field>
        <field name="sequence" eval="100" />
    </record>
</odoo>
